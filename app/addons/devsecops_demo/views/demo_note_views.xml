<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="devsecops_demo_note_view_list" model="ir.ui.view">
        <field name="name">devsecops.demo.note.list</field>
        <field name="model">devsecops.demo.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="devsecops_demo_note_view_form" model="ir.ui.view">
        <field name="name">devsecops.demo.note.form</field>
        <field name="model">devsecops.demo.note</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="Mark done" type="object"
                            invisible="state == 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="devsecops_demo_note_action" model="ir.actions.act_window">
        <field name="name">Demo Notes</field>
        <field name="res_model">devsecops.demo.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="devsecops_demo_menu_root" name="DevSecOps Demo"
              action="devsecops_demo_note_action"/>
</odoo>
